# Production Caddyfile. Live copy on the server: /srv/zrnet/Caddyfile
# (mounted into zrnet-caddy-1 as /etc/caddy/Caddyfile).
# Deploy: scp deploy/Caddyfile root@46.224.178.235:/srv/zrnet/Caddyfile
#         ssh root@46.224.178.235 'docker exec zrnet-caddy-1 caddy validate --config /etc/caddy/Caddyfile && docker exec zrnet-caddy-1 caddy reload --config /etc/caddy/Caddyfile'

bookswiper.com, www.bookswiper.com {
	redir https://pagesinline.com{uri} permanent
}

zenreader.net, www.zenreader.net {
	handle /api/* {
		reverse_proxy zrnet-api-1:4000
	}

	handle /media/* {
		reverse_proxy zrnet-api-1:4000
	}

	handle {
		redir https://pagesinline.com{uri} permanent
	}
}

pagesinline.com {
	encode gzip zstd

	# Public site OFF: every public page shows "Diese Seite ist nicht verfügbar" (HTTP 404).
	# /admin*, the API, media, uploads and the SPA's static files stay reachable;
	# the admin area itself is gated by the backend's admin_auth cookie.
	# To make the site public again, replace the whole last handle block with:
	#   handle { reverse_proxy zrnet-web-1:80 }
	header X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		reverse_proxy zrnet-api-1:4000
	}

	handle /media/* {
		reverse_proxy zrnet-api-1:4000
	}

	handle /uploads/* {
		reverse_proxy zrnet-api-1:4000
	}

	handle {
		@public {
			not path /admin /admin/* /assets/* /icons/* /favicon* /robots.txt
			not path *.js *.css *.png *.jpg *.jpeg *.svg *.ico *.webp *.woff *.woff2 *.json *.webmanifest
		}

		handle @public {
			header Content-Type "text/html; charset=utf-8"
			header Cache-Control "no-store"
			respond <<HTML
				<!doctype html>
				<html lang="de">
				<head>
				<meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<title>Diese Seite ist nicht verfügbar</title>
				</head>
				<body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#fff;color:#202124;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;padding:24px;box-sizing:border-box">
				<main style="max-width:520px;width:100%">
				<h1 style="margin:0 0 12px;font-size:24px;font-weight:500">Diese Seite ist nicht verfügbar</h1>
				<p style="margin:0;color:#5f6368;font-size:14px">HTTP ERROR 404</p>
				</main>
				</body>
				</html>
				HTML 404
		}

		handle {
			reverse_proxy zrnet-web-1:80
		}
	}
}

staging.pagesinline.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy zrnet-staging-api-1:4000
	}

	handle /media/* {
		reverse_proxy zrnet-staging-api-1:4000
	}

	handle {
		reverse_proxy zrnet-staging-web-1:80
	}
}
